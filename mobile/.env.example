# Copy to mobile/env/dev.json, env/staging.json, env/prod.json (git-ignored).
# Values are JSON, passed with:
#   flutter run --flavor dev --dart-define-from-file=env/dev.json
#
# Keys mirror web/example.env (NEXT_PUBLIC_BACKEND_*):
#   BACKEND_PROTOCOL     http | https               (NEXT_PUBLIC_BACKEND_PROTOCOL)
#   BACKEND_WS_PROTOCOL  ws | wss                   (NEXT_PUBLIC_BACKEND_WS_PROTOCOL)
#   BACKEND_HOST         gateway host               (NEXT_PUBLIC_BACKEND_IP_ADDRESS)
#   BACKEND_PORT         gateway port               (NEXT_PUBLIC_BACKEND_PORT)
#   FLAVOR               dev | staging | prod; optional when building with
#                        --flavor (Flutter injects FLUTTER_APP_FLAVOR)
#
# Android emulator reaches the host machine at 10.0.2.2 instead of localhost.
#
# Example env/dev.json:
# {
#   "BACKEND_PROTOCOL": "http",
#   "BACKEND_WS_PROTOCOL": "ws",
#   "BACKEND_HOST": "localhost",
#   "BACKEND_PORT": "8000",
#   "FLAVOR": "dev"
# }
