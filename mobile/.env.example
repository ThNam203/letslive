# Copy to mobile/env/dev.json, env/staging.json, env/prod.json (git-ignored).
# Values are JSON, passed with:
#   flutter run --flavor dev --dart-define-from-file=env/dev.json
#
# Backend (mirror web/example.env, NEXT_PUBLIC_BACKEND_*), always required:
#   BACKEND_PROTOCOL     http | https               (NEXT_PUBLIC_BACKEND_PROTOCOL)
#   BACKEND_WS_PROTOCOL  ws | wss                   (NEXT_PUBLIC_BACKEND_WS_PROTOCOL)
#   BACKEND_HOST         gateway host               (NEXT_PUBLIC_BACKEND_IP_ADDRESS)
#   BACKEND_PORT         gateway port               (NEXT_PUBLIC_BACKEND_PORT)
#   FLAVOR               dev | staging | prod; optional when building with
#                        --flavor (Flutter injects FLUTTER_APP_FLAVOR)
#
# Bot proof for POST /auth/login and /auth/verify-email:
#   TURNSTILE_DEV_TOKEN  dev only, required when Firebase is not configured.
#                        Any non-empty value; the dev stack's Turnstile test
#                        secret accepts it. Ignored in staging/prod.
#
# Firebase (App Check; FCM later). "Configured" means FIREBASE_PROJECT_ID is
# set; then the other keys are required too. Required in staging and prod.
# Values come from the Firebase console (Project settings > Your apps); no
# google-services.json / GoogleService-Info.plist is used.
#   FIREBASE_PROJECT_ID
#   FIREBASE_API_KEY
#   FIREBASE_MESSAGING_SENDER_ID
#   FIREBASE_ANDROID_APP_ID   needed when running on Android
#   FIREBASE_IOS_APP_ID       needed when running on iOS
# Dev with Firebase uses the App Check debug provider: register the debug
# token the app logs in the Firebase console.
#
# Google sign-in. Required in staging and prod; in dev, leaving
# GOOGLE_SERVER_CLIENT_ID out hides the Google button.
#   GOOGLE_SERVER_CLIENT_ID   the WEB OAuth client id (same value as the
#                             backend's GOOGLE_OAUTH_CLIENT_ID), so the id
#                             token's audience is one the backend accepts
#   GOOGLE_IOS_CLIENT_ID      the iOS OAuth client id; needed on iOS when
#                             GOOGLE_SERVER_CLIENT_ID is set (also add its
#                             reversed id as a URL scheme, see README)
#
# Android emulator reaches the host machine at 10.0.2.2 instead of localhost.
#
# Example env/dev.json:
# {
#   "BACKEND_PROTOCOL": "http",
#   "BACKEND_WS_PROTOCOL": "ws",
#   "BACKEND_HOST": "localhost",
#   "BACKEND_PORT": "8000",
#   "FLAVOR": "dev",
#   "TURNSTILE_DEV_TOKEN": "dev-token"
# }
