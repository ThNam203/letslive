<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by the Release-* build configurations (TestFlight / App Store).
	     Debug and Profile builds use Runner.entitlements ("development"). -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- App Check: AppleAppAttestWithDeviceCheckFallbackProvider (staging and
	     prod) needs App Attest. The App ID must have the App Attest capability
	     and the provisioning profile must include it (README store setup). -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
