<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs) for Debug and Profile builds. Release-*
	     configurations use RunnerRelease.entitlements ("production"). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Check: AppleAppAttestWithDeviceCheckFallbackProvider (staging and
	     prod) needs App Attest. The App ID must have the App Attest capability
	     and the provisioning profile must include it (README store setup). -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>development</string>
</dict>
</plist>
